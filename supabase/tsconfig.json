{
  "extends": "@awrad/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Deno resolves relative imports by their real file name (./messages.ts); tsc only type-checks here.
    "allowImportingTsExtensions": true
  },
  "include": ["tests", "functions"],
  // Deno-only entries (Deno globals, npm: imports via deno.json) run under the Supabase Edge Runtime;
  // the logic they call (functions/*/handler.ts) is type-checked here.
  "exclude": ["functions/*/index.ts", "functions/_shared/auth.ts"]
}
