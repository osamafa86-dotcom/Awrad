{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "format": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "env": ["SUPABASE_DB_URL"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".expo/**"]
    }
  }
}
