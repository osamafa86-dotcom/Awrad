# انسخ هذا الملف إلى .env (لا يُرفع). القيم الفارغة تُملأ من لوحة Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# قاعدة بيانات العنقود المحلي (pnpm db:start). تحذير: pnpm db:reset يمسح هذه القاعدة؛
# لا تضع هنا Supabase Docker أو السحابي مع db:reset (السكربت يرفض غير 54329/awrad).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54329/awrad
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
