# syntax=docker/dockerfile:1
# Awrad on the owner's VPS: one Dockerfile, three targets (built by docker-compose.yml, context = repo root).
#   workspace  the whole monorepo with its dependencies — the `web-build` service runs the Expo web export in it
#   build      `next build` of apps/admin with `output: 'standalone'`
#   admin      the runtime image: only the standalone server, as the non-root `node` user
FROM node:22-bookworm-slim AS workspace
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    EXPO_NO_TELEMETRY=1
# pnpm through corepack, pinned to the repo's packageManager; npm as the fallback if corepack cannot fetch it.
RUN (corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm --version) \
    || (npm install -g pnpm@10.28.0 && pnpm --version)
WORKDIR /app
COPY . .
# One plain install; the store lives in a BuildKit cache mount, so a rebuild links instead of downloading.
# Not `pnpm fetch` + `install --offline`: after a fetch, pnpm writes the bin shims without NODE_PATH to the
# hidden hoist (node_modules/.pnpm/node_modules), and Babel then cannot resolve `babel-preset-expo` from
# apps/mobile (server run 2: web-build exit 7). Reproduced and checked in a scratch clone (see the D1 report).
RUN --mount=type=cache,id=awrad-pnpm,target=/pnpm/store pnpm install --frozen-lockfile \
    && grep -q 'NODE_PATH=.*/node_modules/.pnpm/node_modules' apps/mobile/node_modules/.bin/expo

FROM workspace AS build
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
# The host is shared with other sites and BuildKit ignores compose memory limits: cap the Node heap here.
ARG BUILD_HEAP_MB=1536
ENV NODE_OPTIONS=--max-old-space-size=${BUILD_HEAP_MB}
RUN test -n "$NEXT_PUBLIC_SUPABASE_URL" && test -n "$NEXT_PUBLIC_SUPABASE_ANON_KEY" \
    && pnpm --filter admin exec next build \
    && test -f apps/admin/.next/standalone/apps/admin/server.js \
    && mkdir -p apps/admin/public

FROM node:22-bookworm-slim AS admin
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/admin/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build --chown=node:node /app/apps/admin/public ./apps/admin/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/admin/server.js"]
