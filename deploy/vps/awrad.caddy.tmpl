# «أوراد» on the owner's VPS — generated by the ops task into /srv/sites/caddy/<SITE>.caddy (imported by the
# main Caddy), one file per environment. The task fills the four site addresses (http:// prefixed when the
# Cloudflare zone is on Flexible), the TLS line of each block (tls internal, or nothing), the mailbox's
# basic_auth block (bcrypt) and the environment's SITE: the upstreams are the compose aliases <SITE>-admin,
# -auth, -rest, -functions, -mail on deploy_default, and the roots are /srv/www/<SITE>-app and -api — the
# main Caddy mounts the host's /srv/sites/www as /srv/www, so WEB_ROOT=/srv/sites/www/<SITE>-app is served
# from /srv/www/<SITE>-app (a WEB_ROOT outside /srv/sites/www is invisible to Caddy). Placeholder tokens
# appear only on the lines they replace — never in a comment, which the renderer would rewrite too.
# noindex on all four: staging (remove at cutover, by line).

# Sheikh's dashboard (Next.js standalone)
__ADMIN__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	reverse_proxy __SITE__-admin:3000
}

# Student web: the Expo static export (web-build swaps <WEB_ROOT>/current atomically)
__APP__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	root * /srv/www/__SITE__-app/current
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}

# Supabase-compatible API: GoTrue, PostgREST, Edge Runtime, and GoTrue's email templates. Nothing else.
__API__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	handle_path /auth/v1/* {
		reverse_proxy __SITE__-auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy __SITE__-rest:3000
	}
	handle_path /functions/v1/* {
		reverse_proxy __SITE__-functions:9000
	}
	handle /auth-templates/* {
		root * /srv/www/__SITE__-api
		file_server
	}
	handle {
		respond 404
	}
}

# Mailpit: the staging inbox where the sign-in codes land
__MAIL__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	__MAIL_BASICAUTH__
	reverse_proxy __SITE__-mail:8025
}
