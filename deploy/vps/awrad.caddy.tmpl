# «أوراد» staging — generated by the ops task into /srv/sites/caddy/awrad.caddy (imported by the main Caddy).
# The task fills the four site addresses (http:// prefixed when the Cloudflare zone is on Flexible), the TLS
# line of each block (tls internal, or nothing) and the mailbox's basic_auth block (bcrypt). Placeholder tokens
# appear only on the lines they replace — never in a comment, which the renderer would rewrite too.
# noindex on all four: staging (remove at cutover, by line).

# Sheikh's dashboard (Next.js standalone)
__ADMIN__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	reverse_proxy awrad-admin:3000
}

# Student web: the Expo static export (web-build swaps /srv/www/awrad-app/current atomically)
__APP__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	root * /srv/www/awrad-app/current
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}

# Supabase-compatible API: GoTrue, PostgREST, Edge Runtime, and GoTrue's email templates. Nothing else.
__API__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	encode zstd gzip
	handle_path /auth/v1/* {
		reverse_proxy awrad-auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy awrad-rest:3000
	}
	handle_path /functions/v1/* {
		reverse_proxy awrad-functions:9000
	}
	handle /auth-templates/* {
		root * /srv/www/awrad-api
		file_server
	}
	handle {
		respond 404
	}
}

# Mailpit: the staging inbox where the sign-in codes land
__MAIL__ {
	__TLS__
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	__MAIL_BASICAUTH__
	reverse_proxy awrad-mail:8025
}
