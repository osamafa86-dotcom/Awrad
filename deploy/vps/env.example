# /opt/sites/<SITE>/.env — one per environment (600). Read by
#   docker compose -p "$SITE" --env-file /opt/sites/$SITE/.env -f deploy/vps/docker-compose.yml …
# and by seed-demo.sh. The ops task (mahfazapay deploy/ops/task.sh) writes it; nothing here is a real value.
# Check a file without Docker: bash deploy/vps/check-env.sh --render deploy/vps/docker-compose.yml <file>

# ── Identity (not secret) ──
# The compose project name, passed again as -p "$SITE" (must be equal). Prefixes the aliases on deploy_default
# (<SITE>-auth, -rest, -functions, -mail, -admin; <SITE>-db on the project network), the images
# (<SITE>-admin, <SITE>-workspace), the volumes (<SITE>_pgdata) and the default paths below.
# Default awrad (staging). Production: a different value, e.g. awrad-prod.
SITE=awrad
# Public hostnames, without https:// — no defaults: a missing one fails `docker compose config`.
ADMIN_HOST=awrad.emdatra.org
APP_HOST=awrad-app.emdatra.org
API_HOST=awrad-api.emdatra.org
MAIL_HOST=awrad-mail.emdatra.org

# ── Host paths (not secret; defaults shown) ──
# Directory with mail-ui.htpasswd (and the task's other per-environment files). Default /opt/sites/$SITE/secrets.
AWRAD_SECRETS=/opt/sites/awrad/secrets
# Root of the student web; web-build swaps $WEB_ROOT/current. Default /srv/sites/www/$SITE-app. Keep it under
# /srv/sites/www: the main Caddy sees that tree as /srv/www (awrad.caddy.tmpl serves /srv/www/<name>/current).
WEB_ROOT=/srv/sites/www/awrad-app

# ── Secrets (generated once on the server by the ops task; never committed, never printed) ──
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
MAIL_USER=
MAIL_PASSWORD=
# The hourly send-reminders job (Task 4.1); empty = the function always answers 401.
CRON_SECRET=

# ── Set by the ops task per run, not kept here ──
# WEB_BUILD_MEM (default 2048m) and WEB_BUILD_HEAP (default 1536): web-build's memory cap and Node heap.
